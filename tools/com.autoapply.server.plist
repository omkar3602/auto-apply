<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent that keeps the Flask app running in the background: through
  screen locks, terminal closes, and logins. Install:

      cp tools/com.autoapply.server.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.autoapply.server.plist

  See README "Keeping it running in the background" for the rest.

  Note on `caffeinate -s`: it holds off system sleep only while this process
  is alive, and only on AC power - exactly the "plugged in, screen locked"
  case. That's why no permanent `pmset` change is needed. The display still
  sleeps and the screen still locks normally; neither stops the process.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.autoapply.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-s</string>
        <string>/Volumes/Personal/Projects/_NEW_August_2026/auto-apply/.venv/bin/python</string>
        <string>/Volumes/Personal/Projects/_NEW_August_2026/auto-apply/app.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/Personal/Projects/_NEW_August_2026/auto-apply</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>8000</string>
    </dict>

    <!-- start at login, and restart if it ever exits -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- don't spin hot if it crashes on startup (e.g. the /Volumes disk
         holding this project isn't mounted yet) -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/tmp/autoapply.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/autoapply.err.log</string>
</dict>
</plist>
